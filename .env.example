# =============================================================================
# FIG Living — Ads Dashboard — environment config
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# All dates/timestamps are normalized to Asia/Kolkata regardless of this value;
# this only affects log timestamps etc.
TZ=Asia/Kolkata

# --- Supabase (Postgres) ---
SUPABASE_URL=
# Service role key — server-side only, never expose to the web client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string (used by migration runner), e.g.
# postgresql://postgres:[password]@[host]:5432/postgres
DATABASE_URL=

# --- Google Ads ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# --- Meta Ads ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Amazon Ads ---
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_PROFILE_ID=
# e.g. na | eu | fe
AMAZON_REGION=

# --- Myntra ---
# No API credentials — Myntra data is ingested via CSV upload only
# (POST /ingest/myntra). Nothing to configure here.

# --- FX (only wire this up if confirmed an ad account bills in USD) ---
# FX_API_KEY=
