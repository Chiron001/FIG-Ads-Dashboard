# =============================================================================
# FIG Living — Ads Dashboard — environment config
# Copy this file to .env and fill in real values. Never commit .env.
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development
# All dates/timestamps are normalized to Asia/Kolkata regardless of this value;
# this only affects log timestamps etc.
TZ=Asia/Kolkata

# --- Supabase (Postgres) ---
# Project URL — the base URL (Settings -> API), NOT the /rest/v1/ path.
SUPABASE_URL=
# Secret key (Settings -> API Keys -> Secret keys), sb_secret_... — server-side
# only, never expose to the web client. (Legacy service_role JWT also works.)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string used by the migration runner (server/src/db/migrate.ts).
# Use the SESSION POOLER string (Connect panel -> Connection string -> Session
# pooler), not "Direct connection" — the direct db.<ref>.supabase.co host is
# IPv6-only and unreachable from IPv4-only networks. Session pooler is
# dual-stack and works everywhere; note the username becomes
# postgres.<project-ref> instead of plain postgres. URL-encode special
# characters in the password (e.g. @ -> %40).
# postgresql://postgres.<project-ref>:[password]@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# --- Google Ads ---
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# Generate via: npm run google:auth --workspace server
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Only needed if GOOGLE_ADS_CUSTOMER_ID is a client account under a manager
# (MCC) account -- required in that case even if the authenticated user has
# direct access to the client account. Leave blank otherwise.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Meta Ads ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

# --- Amazon Ads ---
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_PROFILE_ID=
# e.g. na | eu | fe
AMAZON_REGION=

# --- Myntra ---
# No API credentials — Myntra data is ingested via CSV upload only
# (POST /ingest/myntra). Nothing to configure here.

# --- Shopify (ground-truth orders/products, not an ad platform) ---
# Admin API access token, scopes read_orders + read_products only. As of
# 2026-01-01 Shopify no longer allows creating new "legacy custom apps" (a
# store-admin-issued static token, no OAuth) -- for a Dev-Dashboard app,
# get this token via the one-time flow at /shopify/oauth/install (needs
# CLIENT_ID/SECRET below set first). Once you have the token, CLIENT_ID/
# SECRET aren't needed for anything else -- the actual connector only ever
# reads STORE_DOMAIN + ADMIN_ACCESS_TOKEN.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- FX (only wire this up if confirmed an ad account bills in USD) ---
# FX_API_KEY=

# --- Campaign table economics (Break-even ROAS, Profit, Verdict) ---
# Blended gross margin as a fraction. Overridable live in the UI top bar;
# this is just the starting default.
GROSS_MARGIN=0.60
# Verdict rule threshold -- ROAS at/above this + high lost-IS -> "Scale".
# Also the goal line for true (website) ROAS across the SKU/creative views.
TARGET_ROAS=5.5
