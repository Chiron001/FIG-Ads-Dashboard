{
  "name": "@fig/server",
  "private": true,
  "version": "0.1.0",
  "description": "FIG Living ads dashboard — Express API, connectors, ETL, cron",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "google:auth": "tsx src/scripts/google-get-refresh-token.ts",
    "google:test": "tsx src/scripts/test-google-connector.ts",
    "meta:test": "tsx src/scripts/test-meta-connector.ts",
    "ga4:test": "tsx src/scripts/test-ga4-connector.ts",
    "amazon:auth": "tsx src/scripts/amazon-get-refresh-token.ts",
    "shopify:test": "tsx src/scripts/test-shopify-connector.ts",
    "shopify:backfill": "tsx src/scripts/shopify-backfill.ts",
    "backfill": "tsx src/scripts/backfill.ts",
    "test": "tsx --test src/stats/*.test.ts src/util/*.test.ts src/etl/*.test.ts src/connectors/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fig/shared": "*",
    "@google-analytics/data": "^7.0.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-ads-api": "^24.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
